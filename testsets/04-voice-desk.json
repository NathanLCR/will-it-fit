{
  "use_case": 4,
  "name": "Voice and desk assistant",
  "system_prompt_file": "frozen/desk-system-prompt.txt",
  "stream": true,
  "grading": "Automatic, per reply, on the streamed output split by the desk-assistant TagStreamParser. Pass = all checks below. Latency reported as median and p90 across items and runs.",
  "checks": {
    "first_sentence_ms": "Time from request sent to the first 'sentence' event. Pass under 1000.",
    "max_sentences": 3,
    "leading_emotion": "Reply starts with [emotion:<name>] using one of the 12 emotions in the prompt.",
    "no_markdown": "(?m)(^\\s*[-*#>]|\\*\\*|`|^\\s*\\d+\\.)",
    "no_pt_pt": "(?i)\\b(est[aá]s|tens|fixe|telem[oó]vel|ecr[aã]|autocarro|pequeno-almo[cç]o|casa de banho|utilizador|rapariga|sumo)\\b|\\best(ou|á|amos|ão) a [a-zà-ú]+(ar|er|ir)\\b",
    "action": "If expect_action is set (a string, or a list where any one is accepted), exactly one matching [action:...] tag must appear. If null, no [action:] tag may appear.",
    "fact": "If expect_fact is true, a [fact:...] tag must appear. If false, none may appear."
  },
  "items": [
    {
      "id": "v01",
      "status": "approved",
      "utterance": "Oi, tudo bem?",
      "expect_action": null,
      "expect_fact": false
    },
    {
      "id": "v02",
      "status": "approved",
      "utterance": "Que horas são?",
      "expect_action": null,
      "expect_fact": false,
      "must_contain": [
        "15[:h]40|três e quarenta|quinze (horas )?e quarenta"
      ]
    },
    {
      "id": "v03",
      "status": "approved",
      "utterance": "Que dia é hoje?",
      "expect_action": null,
      "expect_fact": false,
      "must_contain": [
        "(?i)ter[cç]a|17"
      ]
    },
    {
      "id": "v04",
      "status": "approved",
